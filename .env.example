# AI itineraries — secrets remain on the server.
AI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_BASE_URL=https://api.openai.com/v1

# Zoho CRM v8 OAuth (create a connected app and a refresh token with the minimum Leads scope).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Optional override; otherwise use api_domain returned by Zoho's OAuth token response.
ZOHO_API_DOMAIN=
ZOHO_DEFAULT_COMPANY=Individual traveller

# Alternative lead delivery. Zoho is used first if its credentials are configured.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# TBO Hotels (SOAP HotelService v7). Use the exact HTTPS endpoint and credentials supplied by TBO.
# Search is off unless explicitly enabled; production also requires certification.
TBO_HOTEL_ENABLED=false
TBO_HOTEL_CERTIFIED=false
TBO_HOTEL_ENV=sandbox
TBO_HOTEL_API_URL=
TBO_HOTEL_USERNAME=
TBO_HOTEL_PASSWORD=

# TBO Air requires your partner-specific adapter module and production approval.
# The module must live under integrations/ and implement the documented contract.
TBO_FLIGHT_ENABLED=false
TBO_FLIGHT_ENV=sandbox
TBO_AIR_ADAPTER_MODULE=
TBO_FLIGHT_CERTIFIED=false

# Razorpay — server-side keys only. Live checkout is disabled until every booking gate is ready.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Your persistent booking adapter (integrations/...) must implement the contract in
# integrations/booking-adapter.contract.md; do not use in-memory state for live orders.
TRIWAL_BOOKING_ADAPTER_MODULE=
TRIWAL_LIVE_BOOKING=false

# Server options
PORT=4173
HOST=0.0.0.0
NODE_ENV=development
